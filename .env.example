# Firebird (Gedemin) — TCP к серверному Firebird; Embedded не подходит
FIREBIRD_HOST=127.0.0.1
FIREBIRD_PORT=3050
FIREBIRD_DB=C:\\path\\to\\database.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASS=changeme
FIREBIRD_CHARSET=UTF8
FIREBIRD_AUTH_PLUGIN=legacy
FIREBIRD_WIRE_CRYPT=disable

# MongoDB
MONGODB_URI=mongodb://user:changeme@127.0.0.1:27017/?authSource=admin
MONGODB_DB=king-pos

# Optional: tuning
BATCH_SIZE=1000

# Collection names (defaults in code use dashes)
# COL_GOOD=Good
# COL_GOOD_GROUP=GoodGroup
# COL_PRICE_LIST=pos-priceList
# COL_RESTAURANT_HALL=pos-restaurantHall
# COL_RESTAURANT_TABLE=pos-restaurantTable
# ...
